# -------------------------------------------------------------------
# Local-only state that MUST NOT be published to Git (added 2026-08-08
# when preparing the public release of this TianShu secondary dev).
# Each entry is local-only data with no value to other contributors
# and may leak machine paths, secrets, or large binaries if shipped.
# -------------------------------------------------------------------

# Local agent / IDE configuration
.agent/                       # Trae agent skills (machine-local)
.trae/                        # Trae IDE state (memory logs, e2e attachments)
.ruff_cache/                  # ruff lint cache
.run-logs/                    # quick-start.ps1 backend/frontend logs

# Local-only code-workspace file (path-bound, single developer)
tian-shu.code-workspace

# Per-machine quick-start environment file (may carry secrets / paths)
quick-start.env

# Per-machine app config (carries API keys, DSNs) - keep example only
config.yaml
