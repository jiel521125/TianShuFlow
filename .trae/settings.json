{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/bower_components/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/.cache/**": true,
    "**/coverage/**": true,
    "**/.vite/**": true,
    "**/.turbo/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/venv/**": true,
    "**/.venv/**": true,
    "**/target/**": true,
    "**/.gradle/**": true,
    "**/.idea/**": true,
    "**/.vscode-test/**": true,
    "**/logs/**": true,
    "**/*.log": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.next": true,
    "**/.nuxt": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/venv": true
  },
  "files.associations": {},
  "search.exclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.next/**": true,
    "**/.nuxt/**": true,
    "**/coverage/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/target/**": true,
    "**/.git/**": true
  },
  "editor.quickSuggestions": {
    "other": false,
    "comments": false,
    "strings": false
  },
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.disableAutomaticTypeAcquisition": true,
  "extensions.supportUntrustedWorkspaces": false,
  "trae.ai.indexing.enabled": true,
  "trae.ai.indexing.maxFileSize": 1048576
}